<?xml version="1.0" encoding="utf-8"?>
<!-- Potion/Bite/Soup button, idle (.bst). The button view is 40 dp tall so it is easy to tap
     (plan 1.1 §3.4); the inset keeps the visible pill 24 dp tall like before. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="8dp"
    android:insetBottom="8dp">
    <shape android:shape="rectangle">
        <solid android:color="#2A1E14" />
        <stroke android:width="1.5dp" android:color="#1A120B" />
        <corners android:radius="8dp" />
    </shape>
</inset>
