<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: backup is off (android:allowBackup="false"); this excludes everything as well,
     in case a ROM ignores the flag. The app's data stays on this phone (plan 1.1 §5.6). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
